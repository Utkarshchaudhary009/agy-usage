#!/usr/bin/env sh
# [Husky] pre-commit: auto-format, lint, and guard env files

# 1. Auto-format and lint-fix staged files
echo "[husky] Running format + lint..."
bun run format
bun run lint:write
git add -A

# 2. Guard: never commit .env.local
if [ -f ".env.local" ]; then
  rm -f .env.local
  git restore --staged .env.local 2>/dev/null || true
  echo "[husky] Removed .env.local (never commit real env — use .env.local.example)"
fi

if git diff --cached --name-only | grep -q "^\.env\.local$"; then
  echo "[husky] ERROR: .env.local is staged. Aborting commit."
  exit 1
fi
